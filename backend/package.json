{
  "name": "consolas-backend",
  "version": "1.0.0",
  "description": "API REST para la gestión de mantenimiento, reparación y venta de consolas",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node scripts/iniciar-produccion.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "verificar-claves": "node scripts/verificar-claves.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json"
  }
}
